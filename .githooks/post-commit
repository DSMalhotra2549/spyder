#!/bin/sh
# After every commit on main, rebuild and reinstall the local Spyder in the background
# (scripts/install-local.ps1; log in release/install-local.log). Enabled by
# `git config core.hooksPath .githooks`.
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
nohup powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/install-local.ps1 >/dev/null 2>&1 &
exit 0
